{
  "name": "asset-sweep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "asset-sweep": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "description": "Automatically detect and remove unused CSS and JavaScript from your web projects",
  "keywords": [
    "css",
    "javascript",
    "unused",
    "cleanup",
    "performance",
    "optimization",
    "dead-code",
    "bundle-size",
    "web-performance"
  ],
  "author": "Steve Kinzey (https://github.com/SteveKinzey)",
  "license": "MIT",
  "homepage": "https://github.com/SteveKinzey/Asset-Sweep-Remove-Unused-CSS-JS#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveKinzey/Asset-Sweep-Remove-Unused-CSS-JS.git"
  },
  "bugs": {
    "url": "https://github.com/SteveKinzey/Asset-Sweep-Remove-Unused-CSS-JS/issues"
  },
  "engines": {
    "node": "20 || >=22",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "benchmark": "node scripts/benchmark.js",
    "prepublishOnly": "npm run build && npm test && npm run verify:artifacts",
    "verify:artifacts": "node -e \"const fs=require('fs'),m=['dist/index.js','bin/cli.js'].filter(p=>!fs.existsSync(p));if(m.length){console.error('\\u2716 refusing to publish, missing build output: '+m.join(', '));process.exit(1)}console.log('\\u2714 build artifacts present')\""
  },
  "dependencies": {
    "glob": "^14.0.3",
    "minimist": "^1.2.8",
    "parse5": "^8.0.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "$glob"
  }
}
