{
  "name": "asset-sweep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "asset-sweep": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "description": "Automatically detect and remove unused CSS and JavaScript from your web projects",
  "keywords": [
    "css",
    "javascript",
    "unused",
    "cleanup",
    "performance",
    "optimization",
    "dead-code",
    "bundle-size",
    "web-performance"
  ],
  "author": "Steve Kinzey (https://github.com/SteveKinzey)",
  "license": "MIT",
  "homepage": "https://github.com/SteveKinzey/Asset-Sweep-Remove-Unused-CSS-JS#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveKinzey/Asset-Sweep-Remove-Unused-CSS-JS.git"
  },
  "bugs": {
    "url": "https://github.com/SteveKinzey/Asset-Sweep-Remove-Unused-CSS-JS/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.js",
    "prepublishOnly": "npm run build && npm test && npm run verify:artifacts",
    "verify:artifacts": "node -e \"const fs=require('fs'),m=['dist/index.js','bin/cli.js'].filter(p=>!fs.existsSync(p));if(m.length){console.error('\\u2716 refusing to publish, missing build output: '+m.join(', '));process.exit(1)}console.log('\\u2714 build artifacts present')\""
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "glob": "^10.3.0",
    "minimist": "^1.2.8",
    "parse5": "^8.0.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.6.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.1.0"
  }
}
